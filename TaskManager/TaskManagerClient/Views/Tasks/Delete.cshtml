@model TaskManagerClient.Models.TaskItem

@{
    ViewData["Title"] = "Удаление задачи";
}

<h1>Удаление задачи</h1>

<div class="alert alert-warning">
    Вы действительно хотите удалить эту задачу?
</div>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>ID:</strong> @Model.Id</p>
        <p><strong>Название:</strong> @Model.Title</p>
        <p><strong>Описание:</strong> @Model.Description</p>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post"
      onsubmit="return confirm('Вы уверены, что хотите удалить задачу?');">
    <button type="submit" class="btn btn-danger">Да, удалить</button>
    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
</form>
