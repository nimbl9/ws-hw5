@model List<TaskManagerClient.Models.TaskItem>

@{
    ViewData["Title"] = "Список задач";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Список задач</h1>
    <a asp-action="Create" class="btn btn-primary">Добавить задачу</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-bordered table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Описание</th>
            <th>Статус</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="5" class="text-center">Задач пока нет</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Title</td>
                    <td>@item.Description</td>
                    <td>
                        @if (item.IsCompleted)
                        {
                            <span class="badge bg-success">Выполнено</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">В работе</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-info">Открыть</a>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">Удалить</a>
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
